# Copy to .env and set your keys. .env is gitignored; never commit real keys.
# Config (config/config.yaml) holds model, api_base, max_calls; env holds secrets.

# UMass Keymaker / LiteLLM proxy (used when api_base is https://thekeymaker.umass.edu/)
# Use your Keymaker API key (starts with sk-), not the base URL.
AGENT_API_KEY="sk-your-keymaker-api-key"

# Optional: direct provider keys if not using Keymaker
# LITELLM_MASTER_KEY="sk-....."
