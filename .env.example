# Copy to .env and set your keys. .env is gitignored; never commit real keys.
# Config (config/config.yaml) holds model, api_base, max_calls; env holds secrets.

# UMass Keymaker / LiteLLM proxy (used when api_base is https://thekeymaker.umass.edu/)
# Use your Keymaker API key (starts with sk-), not the base URL.
AGENT_API_KEY="sk-your-keymaker-api-key"

# Optional: direct provider keys if not using Keymaker
# LITELLM_MASTER_KEY="sk-....."

# --- courtlistener-pipeline-generic/fetch_courtlistener_generic.py ---
# Loaded from repo .env (python-dotenv). CLI flags override these when you pass them.
# COURTLISTENER_OUTPUT_DIR="./courtlistener-pipeline-generic/courtlistener_cases"
# COURTLISTENER_SEEN_URLS_FILE="seen_urls.txt"
# COURTLISTENER_MAX_CASES=100
# COURTLISTENER_START_PAGE=1
# COURTLISTENER_REQUEST_DELAY=1.0
# COURTLISTENER_MAX_PAGES=500
# COURTLISTENER_CONFIG=""   # path to pipeline.example.json
# One search URL, or multiple lines in COURTLISTENER_SEARCH_URLS:
# COURTLISTENER_SEARCH_URL="https://www.courtlistener.com/?type=r&order_by=score+desc&available_only=on&nature_of_suit=442&court=nysd"
# COURTLISTENER_DOCKET_URL="https://www.courtlistener.com/docket/71540902/green-v-university-of-mississippi-medical-center/"
# COURTLISTENER_USE_FIREFOX=0
# COURTLISTENER_HEADLESS=0
# COURTLISTENER_DEBUG_SAVE_HTML=0
# COURTLISTENER_DEBUG_HTML_PATH="debug_search_page.html"

# Official CourtListener REST API (used elsewhere in this repo, not by Selenium fetcher)
# COURTLISTENER_API_TOKEN=""

# courtlistener-pipeline-generic/process_courtlistener_documents.py (--use-llm, etc.)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""
